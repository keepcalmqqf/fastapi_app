# 复制为 .env 后按需修改；.env 已在 .gitignore 中
# 运行模式，大小写不敏感（会去空白并转大写后比较）
MODE=DEV

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=fastapi_db

# 数据库连接池（仅应用运行时，Alembic 迁移不受影响）
# DB_POOL_RECYCLE 需小于 MySQL wait_timeout
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_POOL_TIMEOUT=30

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis AUTH 密码，默认留空（免密）；生产环境（docker-compose.prod.yml 会执行 requirepass）务必设置
REDIS_PASSWORD=

# JWT（PROD 模式必须修改；SECRET_KEY 至少 32 字节，短于该值会拒绝启动）
SECRET_KEY=dev-only-secret-key-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 认证 Cookie：是否仅通过 HTTPS 发送（Secure 标记）；不设置时 PROD=true、DEV=false
# COOKIE_SECURE=true

# /metrics 访问令牌：配置后访问 /metrics 必须携带 Authorization: Bearer <token>；不配置保持公开
# METRICS_TOKEN=your-random-metrics-token

# CORS（逗号分隔；默认值已含 Vite dev server 5173，开发环境直连调试无需修改）
# 不支持通配符 "*"：本服务启用 allow_credentials，通配等于对全网开放带凭证跨域
CORS_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173

# 邮箱验证：默认不强制（未验证也能登录）；置 true 后未验证账号登录返回 403
REQUIRE_EMAIL_VERIFICATION=false
# 验证令牌有效期（小时）与验证链接基础地址（前端页面地址）
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFY_URL_BASE=http://localhost:5173/verify-email

# 空库自举开关：不设置时 DEV 开、PROD 关。
# PROD 下开放意味着服务启动后任何人抢先调用 /user/create_user 即可成为管理员
# ALLOW_BOOTSTRAP=false

# 前端构建产物目录（存在时由后端托管）
FRONTEND_DIST_DIR=frontend/dist

# 可插拔能力开关
ENABLE_RATE_LIMIT=false
RATE_LIMIT=100/minute
# 限流计数存储：留空时自动推导为 Redis（按上面的 REDIS_HOST/PORT/PASSWORD 拼，
# 密码特殊字符会自动 URL 编码），多 worker 下共享计数，阈值精确等于 RATE_LIMIT。
# 需要强制退回进程内存（单机调试、测试）时设为 memory://
# RATE_LIMIT_STORAGE_URI=memory://
ENABLE_METRICS=false
ENABLE_REQUEST_ID=true
# Swagger 文档开关：DEV 默认开，PROD 默认关（控制 /docs 与 /openapi.json）
ENABLE_DOCS=true
# 会员（C 端用户）模块开关，关闭后 /member 路由不注册
ENABLE_MEMBER=true
