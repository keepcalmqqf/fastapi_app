# 复制为 .env 后按需修改；.env 已在 .gitignore 中
# 运行模式，大小写不敏感（会去空白并转大写后比较）
MODE=DEV

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=fastapi_db

# 数据库连接池（仅应用运行时，Alembic 迁移不受影响）
# DB_POOL_RECYCLE 需小于 MySQL wait_timeout
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_POOL_TIMEOUT=30

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis AUTH 密码，默认留空（免密）；生产环境（docker-compose.prod.yml 会执行 requirepass）务必设置
REDIS_PASSWORD=

# JWT（PROD 模式必须修改；SECRET_KEY 至少 32 字节，短于该值会拒绝启动）
SECRET_KEY=dev-only-secret-key-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 认证 Cookie：是否仅通过 HTTPS 发送（Secure 标记）；不设置时 PROD=true、DEV=false
# COOKIE_SECURE=true

# /metrics 访问令牌：配置后访问 /metrics 必须携带 Authorization: Bearer <token>；不配置保持公开
# METRICS_TOKEN=your-random-metrics-token

# CORS（逗号分隔；默认值已含 Vite dev server 5173，开发环境直连调试无需修改）
# 不支持通配符 "*"：本服务启用 allow_credentials，通配等于对全网开放带凭证跨域
CORS_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173

# 邮箱验证：默认不强制（未验证也能登录）；置 true 后未验证账号登录返回 403
REQUIRE_EMAIL_VERIFICATION=false
# 验证令牌有效期（小时）与验证链接基础地址（前端页面地址）
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFY_URL_BASE=http://localhost:5173/verify-email

# 空库自举开关：不设置时 DEV 开、PROD 关。
# 控制 POST /api/v1/auth/bootstrap（初始化首个管理员）；日常创建后台账号走
# POST /api/v1/user/，恒需 admin 令牌与 user:write 权限
# ALLOW_BOOTSTRAP=false

# 登录防爆破：同一账号连续失败达阈值后锁定若干秒（计数存 Redis，Redis 不可用时不锁定）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# 来源 IP 维度的失败阈值；0 表示不启用（IP 层已有全局限流兜底）
LOGIN_IP_MAX_FAILURES=0

# 前端构建产物目录（存在时由后端托管）
FRONTEND_DIST_DIR=frontend/dist

# 可插拔能力开关
ENABLE_RATE_LIMIT=false
RATE_LIMIT=100/minute
# 限流计数存储：留空时自动推导为 Redis（按上面的 REDIS_HOST/PORT/PASSWORD 拼，
# 密码特殊字符会自动 URL 编码），多 worker 下共享计数，阈值精确等于 RATE_LIMIT。
# 需要强制退回进程内存（单机调试、测试）时设为 memory://
# RATE_LIMIT_STORAGE_URI=memory://
ENABLE_METRICS=false
ENABLE_REQUEST_ID=true
# 国际化插件：按请求解析语种（?locale= / Accept-Language）并翻译统一响应文案
ENABLE_I18N=true
# 支持的语种与默认语种；词条表在 app/plugins/i18n.py
I18N_LOCALES=zh-CN,en-US
I18N_DEFAULT_LOCALE=zh-CN
# Swagger 文档开关：DEV 默认开，PROD 默认关（控制 /docs 与 /openapi.json）
ENABLE_DOCS=true
# 会员（C 端用户）模块开关，关闭后 /member 路由不注册
ENABLE_MEMBER=true

# WebSocket 实时通信插件：关闭时路由不注册（与未集成行为一致）
# ENABLE_WEBSOCKET=true
# 端点路径（必须以 / 开头，会自动去除末尾斜杠）
# WEBSOCKET_PATH=/ws
# 连接是否强制 JWT 鉴权；关闭则允许匿名连接
# WEBSOCKET_AUTH_REQUIRED=true
# 单实例最大并发连接数，达上限后新连接以 1013（稍后重试）拒绝；
# 多实例部署需在前面挂 LB/网关做全局限流，本上限只约束单进程
# WEBSOCKET_MAX_CONNECTIONS=1000

# 异步任务插件：进程内后台任务执行器（发邮件、清理、外部回调等 Fire-and-forget 场景）。
# 关闭时连路由与 worker 都不存在，与未集成行为一致。
# ENABLE_TASKS=true
# 后端：memory=进程内有界队列+worker 协程（单机、重启即丢）；
#       redis=Redis Streams 消费组（分布式、跨进程/跨机、可恢复、失败重试）
# TASK_BACKEND=memory
# worker 协程数：memory 为进程内并发消费数；redis 为单个 worker 进程内的消费者数
# TASK_WORKERS=4
# 任务队列容量上限；0 表示无界（仅受内存约束）。队列满时 submit 直接拒绝而非阻塞请求
# TASK_MAX_QUEUE=0
# 关闭时等待在途任务自然收尾的最长秒数；超时则强制取消剩余任务
# TASK_SHUTDOWN_TIMEOUT=10.0

# ---- 分布式（TASK_BACKEND=redis）专用配置 ----
# 注意：redis 后端只支持具名任务（在 TASK_TASKS_MODULE 里用 @task_manager.task 注册），
# 本地闭包无法跨进程序列化；任务参数须可 JSON 序列化；处理器需幂等（at-least-once）。
# 启动 worker：python -m app.plugins.tasks_worker   （可多进程/多机平行扩容）
# Stream 键名与消费组名（按业务可分队列隔离）
# TASK_STREAM=task:jobs
# TASK_GROUP=task:workers
# 任务结果/状态哈希（task:result:<job_id>）过期秒数；经 GET /api/v1/tasks?job_id=xxx 查询
# TASK_RESULT_TTL=86400
# 执行失败后的最大自动重试次数（不含首次）
# TASK_MAX_RETRIES=3
# 消费者阻塞读取毫秒数（XREADGROUP BLOCK）；0 表示一直阻塞
# TASK_BLOCK_MS=5000
# 回收：pending 中空闲超过该毫秒的条目视为掉线消费者遗留，由 XAUTOCLAIM 抢回重投
# TASK_CLAIM_MIN_IDLE_MS=60000
# TASK_RECLAIM_INTERVAL=30.0
# 具名任务定义模块（Web 端与 worker 都会 import 以解析名称→处理器）
# TASK_TASKS_MODULE=app.tasks
# worker 消费组内消费者名前缀；留空则用 主机名-pid 保证多进程/多机不冲突
# TASK_CONSUMER_NAME=

# 定时任务调度插件：只做触发器，到点经 task_manager 投递具名任务，执行复用 tasks 插件。
# 任务在 TASK_TASKS_MODULE 里用 @scheduler.cron("0 3 * * *", name="...") 定义；
# memory 后端下需同时开启 ENABLE_TASKS 才有消费者执行任务；观测走 GET /api/v1/scheduler
# ENABLE_SCHEDULER=true
# cron 表达式的求值时区（IANA 名，如 Asia/Shanghai）；记录与比较统一用 UTC
# SCHEDULER_TIMEZONE=UTC
# 多实例防重复投递锁（sched:lock:<任务名>:<触发时刻>）过期秒数，需长过最小周期间隔
# SCHEDULER_LOCK_TTL=3600
